# ==============================================================================
# AI StudyMate — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider Configuration (Optional)
# If no provider API key is supplied, AI StudyMate automatically runs in its
# reliable offline fallback mode (extractive RAG, local search, deterministic quiz generation).
# Supported providers: "gemini" | "openai" | "mock"
AI_PROVIDER=gemini

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Speech-to-Text Provider (Optional: "openai_whisper" | "mock")
STT_PROVIDER=mock

# Storage & Database
DATABASE_PATH=./data/studymate.sqlite
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Demo Mode & Seeding
ENABLE_DEMO_SEEDING=true
